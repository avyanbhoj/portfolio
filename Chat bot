<div id="chatbot" style="position:fixed;bottom:20px;right:20px;width:300px;height:400px;border:1px solid #ccc;background:#fff;box-shadow:0 0 10px rgba(0,0,0,0.1);"> <div style="background:#007bff;color:#fff;padding:10px;font-weight:bold;">Chatbot</div> <div id="chatbot-messages" style="height:320px;overflow-y:auto;padding:10px;font-family:sans-serif;font-size:14px;"></div> <input id="chatbot-input" type="text" placeholder="Type your message..." style="width:calc(100% - 20px);margin:10px;padding:5px;" /> </div> <script> const messages = document.getElementById('chatbot-messages'); const input = document.getElementById('chatbot-input'); function appendMessage(text, fromUser) { const msg = document.createElement('div'); msg.style.marginBottom = '10px'; msg.style.padding = '8px'; msg.style.borderRadius = '5px'; msg.style.background = fromUser ? '#007bff' : '#f1f1f1'; msg.style.color = fromUser ? '#fff' : '#000'; msg.textContent = text; messages.appendChild(msg); messages.scrollTop = messages.scrollHeight; } input.addEventListener('keypress', function(e) { if (e.key === 'Enter' && input.value.trim() !== '') { const userText = input.value.trim(); appendMessage(userText, true); input.value = ''; // Simple bot response logic setTimeout(() => { let botReply = "Sorry, I can only provide limited responses right now."; if (userText.toLowerCase().includes('hello')) { botReply = "Hello! How can I assist you today?"; } else if (userText.toLowerCase().includes('help')) { botReply = "Sure! Ask me anything about Avyan or this website."; } appendMessage(botReply, false); }, 500); } }); </script>
